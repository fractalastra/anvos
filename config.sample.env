# AstraNova ANVOS node layer — configuracion de despliegue (ejemplo).
# TODAS las direcciones y nombres salen del codigo: se declaran aqui.
# Sin declaracion, cada pieza queda en su modo fail-closed (sin pares, sin
# empuje, solo local). Copiar a tu gestor de entorno (systemd Environment=,
# EnvironmentFile=, etc.) y ajustar.

# --- Flota / anillo -------------------------------------------------------
# Pares de flota (fleet_attest, fleet_consensus): URLs separadas por comas.
ANVOS_FLEET_PEERS=
# Pares de anclaje (fleet_anchor): URLs separadas por comas.
ANVOS_ANCHOR_PEERS=
# Prefijo de la subred del anillo (ring_transport). Defecto: 127. (solo local)
ANVOS_RING_NET=
# AllowedIPs por defecto del enlace WG si el peer no lo declara (ring_link).
ANVOS_RING_ALLOWED=
# Prefijo de la malla de pares para la puerta /fleet (node_status_server).
# VACIO = /fleet exige sesion (fail-closed).
ANVOS_MESH_PREFIX=

# --- Master / telemetria --------------------------------------------------
# URL del master para telemetria empujada (telem_push). VACIO = no se empuja.
ANVOS_MASTER=
# Endpoint Ollama del anillo para el router de IA (ai_router). VACIO = solo local.
ANVOS_OLLAMA_RING=
# Firmante externo opcional de la cola (anv-crit-escalator). VACIO = sin firma diferida.
ANVOS_SIGN_AGENT=

# --- Confianza ------------------------------------------------------------
# Publica adicional de la clave de servicio (realm_activate, fleet_attest).
ANVOS_ANSERVICE_PUB=
ANVOS_EXTRA_SERVICE_PUB=

# --- Vigias de red --------------------------------------------------------
# Prefijos de confianza de netflow (mod_netflow). Defecto: 127.,0.0.0.0
ANVOS_NETFLOW_TRUSTED=
# Prefijos permitidos del fib_guard. Defecto: 127.,::1
ANVOS_FIB_WHITELIST=

# --- Lenguaje / sujetos (voz_operador, intent_compile) --------------------
ANVOS_KNOWN_TARGETS=
ANVOS_SUJETOS_AJENOS=

# --- Exploracion (ai_explore) --------------------------------------------
EXPLORE_BRAIN_SSH_HOST=
EXPLORE_BRAIN_SSH_KEY=
